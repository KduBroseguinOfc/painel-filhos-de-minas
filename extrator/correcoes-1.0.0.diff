+// FORA DO RECORTE: o recorte do extrator e DUM dentro de 365 dias (mesma regra da consulta ao DW). Item pendente cuja
+// DUM ja passou disso nao e mais relido nem tem como ser aceito como gestacao em curso: fica marcado e deixa de ser
+// enviado a cada hora. Se a DUM for corrigida no PEC e voltar ao recorte, o item volta a fila.
+function markOutOfScope(moduleId, days = 365) {
+  const dbInstance = getDb();
+  const marcados = dbInstance
+    .prepare(
+      `UPDATE module_items SET status_response = 'fora_recorte',
+              message_response = 'Fora do recorte: DUM ha mais de ' || @days || ' dias (nao enviado)',
+              updated_at = CURRENT_TIMESTAMP
+        WHERE module_id = @moduleId AND queued = 0
+          AND dum IS NOT NULL AND TRIM(dum) <> ''
+          AND date(substr(dum, 1, 10)) < date('now', '-' || @days || ' day')
+          AND (status_response IS NULL OR status_response <> 'fora_recorte')`
+    )
+    .run({ moduleId, days }).changes;
+  const devolvidos = dbInstance
+    .prepare(
+      `UPDATE module_items SET status_response = NULL, message_response = NULL, updated_at = CURRENT_TIMESTAMP
+        WHERE module_id = @moduleId AND queued = 0 AND status_response = 'fora_recorte'
+          AND (dum IS NULL OR TRIM(dum) = '' OR date(substr(dum, 1, 10)) >= date('now', '-' || @days || ' day'))`
+    )
+    .run({ moduleId, days }).changes;
+  return { marcados, devolvidos };
+}
+
