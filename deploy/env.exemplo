# Painel Filhos de Minas — configuracao do municipio. O instalador copia este arquivo para /etc/painel-filhosdeminas/env
# (root:painelfm 640). Linhas com # sao comentario. Mudou algo? `systemctl restart painel-filhosdeminas`.
# Preencha pelo menos: MUNICIPIO, UF, NOME_DNS, IP_APP, DW_* e, se for instalar o extrator junto, o bloco EXTRATOR_*.

# --- Municipio (aparece nas telas, e-mails e no robo do Telegram) ---------------------------------------------
MUNICIPIO=Nome do Municipio
UF=MG
PREFEITURA=Prefeitura Municipal de Nome do Municipio
ORGAO=Secretaria Municipal de Saude

# --- Rede interna: nome e IP pelos quais o painel sera acessado ------------------------------------------------
# O instalador gera um certificado autoassinado para este nome (e para o IP) e publica em https://NOME_DNS.
# Crie o registro A no DNS interno do municipio apontando NOME_DNS para IP_APP.
NOME_DNS=filhosdeminas.saude.municipio.local
IP_APP=10.0.0.10
# Se houver um proxy reverso na frente (publicacao fora desta rede), a URL que o usuario digita; senao, deixe igual
URL_PUBLICA=https://filhosdeminas.saude.municipio.local
# Outros nomes aceitos (separados por virgula), opcional
HOSTS_EXTRAS=
# IP do proxy reverso do municipio, se houver (separados por virgula): o painel passa a registrar o IP real do usuario
PROXY_REVERSO_IP=

# --- DW do PEC e-SUS (PostgreSQL), SOMENTE LEITURA ------------------------------------------------------------
# Papel criado por deploy/dw-papel-somente-leitura.sql no servidor do banco do PEC (README, passo 1).
# Banco embutido do instalador do PEC: porta 5433 (veja spring.datasource.url no application.properties do PEC).
DW_HOST=10.0.0.5
DW_PORT=5433
DW_DB=esus
DW_USER=painelfm_ro
DW_PASSWORD=

# --- API do Filhos de Minas (SES-MG): conta do municipio, so leitura na conferencia diaria --------------------
SES_API_URL=https://filhosdeminas.saude.mg.gov.br/api
SES_API_USER=
SES_API_PASSWORD=

# --- Login ------------------------------------------------------------------------------------------------------
# 0 = so usuarios locais (tela Usuarios; o instalador cria o admin). 1 = tambem o SSO do municipio (OpenID Connect).
SSO_ATIVO=0
# Com SSO: emissor (issuer) do provedor; os endpoints sao lidos de <OIDC_ISSUER>/.well-known/openid-configuration.
# Se o provedor nao publicar o documento, informe OIDC_AUTHORIZATION_ENDPOINT, OIDC_TOKEN_ENDPOINT,
# OIDC_USERINFO_ENDPOINT, OIDC_JWKS_ENDPOINT e (opcional) OIDC_END_SESSION_ENDPOINT.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_SIGN_ALGO=RS256
OIDC_CLAIM_USUARIO=preferred_username
OIDC_CLAIM_GRUPOS=groups
# Grupos (claim acima) que entram como administrador; vazio = ninguem pelo SSO (so administradores locais)
SSO_GRUPOS_ADMIN=
# Grupos que podem entrar (visualizacao); vazio = qualquer usuario que o provedor autenticar
SSO_GRUPOS_ACESSO=
# Como o botao chama o SSO
SSO_NOME=login unico
# Com SSO ativo, o login local fica restrito a estas origens (IP ou rede CIDR, separados por virgula); vazio = qualquer
LOGIN_LOCAL_IPS=

# --- Alertas (opcionais) ------------------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
# Dominios aceitos no e-mail de destino dos alertas (separados por virgula); vazio = qualquer
EMAIL_DOMINIOS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NOME=

# --- Mapa / geocodificacao (OpenStreetMap) ---------------------------------------------------------------------
# Contato exigido pela politica do Nominatim (um e-mail do municipio)
GEO_CONTATO=
# Caixa do municipio lat_sul,lat_norte,lon_oeste,lon_leste; vazia = descoberta pelo nome do municipio
GEO_CAIXA=

# --- Diversos ---------------------------------------------------------------------------------------------------
# 0 = CPF mascarado na lista e no detalhe (revelar sob clique, registrado na trilha); 1 = sempre completo
CPF_COMPLETO_PADRAO=0
FUSO=America/Sao_Paulo
# Logotipo/brasao do municipio (PNG ou SVG) mostrado no menu e na TV; sem o arquivo, o padrao do painel
LOGO=/var/lib/painel-filhosdeminas/logo.png
# Fotos das unidades: <cnes>.jpg nesta pasta aparecem no pino do mapa
FOTOS_UBS=/var/lib/painel-filhosdeminas/fotos-ubs

# --- Extrator PEC e-SUS (SES-MG) — opcional: o instalador tambem instala e configura o extrator nesta maquina --------
# Caminho do pacote CLI oficial baixado em https://atualizacoes-extrator-pec-esus.saude.mg.gov.br (extrator-pec-esus-<versao>.tgz)
EXTRATOR_INSTALAR=1
EXTRATOR_PACOTE=/root/extrator-pec-esus-1.0.0.tgz
# 1 = aplica as correcoes deste repositorio (extrator/README.md) sobre o pacote 1.0.0; 0 = pacote oficial puro
EXTRATOR_CORRECOES=1
# 1 = liga a rotina horaria (importa do DW e ENVIA a SES-MG). 0 = instala e configura, mas nao envia (teste)
EXTRATOR_ROTINA=1
# Usuario do DW usado pelo extrator: o esus_leitura criado pelo instalador do PEC (senha no credenciais.txt do PEC).
# Nao use o painelfm_ro: o extrator le tabelas que ele nao tem (tb_dim_cbo, por exemplo).
EXTRATOR_DW_USER=
EXTRATOR_DW_PASSWORD=
# Responsavel no municipio (vai na configuracao do extrator, exigida pela SES-MG)
EXTRATOR_RESP_NOME=
EXTRATOR_RESP_EMAIL=
EXTRATOR_RESP_TELEFONE=
EXTRATOR_RESP_CARGO=
NODE_VERSAO=24.22.1

# --- Gerado pelo instalador (nao preencher) ---------------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DB_PAINEL=/var/lib/painel-filhosdeminas/painel.db
EXTRATOR_DB=/opt/extrator-esus/.extrator-pec-esus/data/extrator-local.db
EXTRATOR_LOG=/opt/extrator-esus/logs/filhos_de_minas_hourly.log
